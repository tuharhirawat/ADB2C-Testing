@model IEnumerable<WorkOrderTaxDetails>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WorkOrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaxAmount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TaxType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.WorkOrderId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TaxAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TaxType)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.WorkOrderTaxDetailsId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.WorkOrderTaxDetailsId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.WorkOrderTaxDetailsId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
