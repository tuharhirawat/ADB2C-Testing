@model IEnumerable<WorkOrderDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.WoStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DepartmentId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WoDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WoTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StaffId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkOrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WorkflowNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.WoStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DepartmentId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WoDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WoTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StaffId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkOrderId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkflowNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.WoDetailId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.WoDetailId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.WoDetailId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
